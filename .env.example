# Copy this file to .env (local dev) or set these as environment variables
# in your hosting provider (e.g. Vercel project settings) for deployed
# environments. Never commit a real .env file.

# Postgres connection string. Locally this points at your dev database;
# in production this comes from your managed Postgres provider (e.g. Neon,
# Supabase, or Vercel Postgres).
DATABASE_URL="postgresql://user:password@localhost:5432/kickoff_rugby_dev"

# Random secret used to sign admin login sessions. Generate one with:
#   openssl rand -base64 32
# Must be at least 32 characters. Changing this logs everyone out.
SESSION_SECRET=""

# Anthropic API key, used by the AI-assisted sourcing feature (Admin > AI
# Sourcing). Get one at https://console.anthropic.com/settings/keys
# Without this set, every other admin feature still works -- only sourcing
# search is disabled.
ANTHROPIC_API_KEY=""

# Optional: override the Claude model used for sourcing. See
# https://docs.claude.com/en/docs/about-claude/models for current model IDs.
# ANTHROPIC_MODEL="claude-sonnet-4-5"

# Optional: salt mixed into the hash used for public-form rate limiting
# (src/lib/rate-limit.ts). Only matters if you want the hash to be
# unguessable across deployments; a sensible default is used if unset.
# RATE_LIMIT_SALT=""
